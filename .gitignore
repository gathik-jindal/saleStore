# =========================================================================
# Build Tool Artifacts (Maven and Gradle)
# =========================================================================
target/
build/
out/
.gradle/
/bin/

# Keep build wrappers but ignore their downloaded distributions
!gradle-wrapper.jar
!maven-wrapper.jar

# =========================================================================
# Spring Boot Specifics
# =========================================================================
.sts4-cache/
.springBeans/
*.log
logs/

# Sensitive Configuration (Never commit secrets or local overrides)
.env
.env.local
*.properties.local
*.yml.local

# Ignore local overrides, but keep committed Spring Boot defaults.
application-local.properties
application-local.yml

# =========================================================================
# IDE Settings (IntelliJ IDEA, Eclipse, VS Code)
# =========================================================================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / Spring Tool Suite (STS)
.metadata/
.classpath
.project
.settings/
.factorypath
.springBeans

# Visual Studio Code
.vscode/

# =========================================================================
# Operating System Files
# =========================================================================
.DS_Store
Thumbs.db
Desktop.ini
